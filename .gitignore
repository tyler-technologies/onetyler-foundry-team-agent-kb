# Never commit credentials to this repo.
*.env
.env*
foundry-secrets*
*secrets*
*credentials*
*.pem
*.key

# Raw, UNREDACTED transcript dumps must never be committed. The reviewable
# transcripts under transcripts/ ARE tracked — they are written by
# scripts/fetch_transcripts.py, which redacts credentials and staff emails on the
# way in. Anything matching the patterns below is a raw dump; keep it out.
*_dump.json
raw_transcripts*.json
foundry_*.json
/tmp/

# OS / editor
.DS_Store
.vscode/
.idea/
