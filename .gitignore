# Never commit credentials to this repo.
*.env
.env*
foundry-secrets*
*secrets*
*credentials*
*.pem
*.key

# Raw, UNREDACTED transcript dumps must never be committed. The reviewable
# transcripts under transcripts/ ARE tracked — they are written by
# scripts/fetch_transcripts.py, which redacts credentials and staff emails on the
# way in. Anything matching the patterns below is a raw dump; keep it out.
*_dump.json
raw_transcripts*.json
foundry_*.json
/tmp/

# Python build artifacts — a compiled .pyc got committed once because importing
# fetch_transcripts.py to unit-test its redaction regex generates one.
__pycache__/
*.pyc

# OS / editor
.DS_Store
.vscode/
.idea/

# When the transcript sync last ran. Local state about this checkout, not content -
# committing it would make every sync a spurious diff and every pull a conflict.
.last-transcript-sync
.last-pr-sync
.last-analytics-sync

# Eval restore points. Written before a candidate upload so a crash mid-eval is recoverable;
# they hold a copy of live Foundry content, so they belong on the machine that made them and
# nowhere else. `eval_batch.py --restore-only <dir>` reads them.
.eval/

# Per-transcript Blueprint patches, awaiting their own change requests. Local working state for
# a DIFFERENT repo's tree, so committing them here would put Blueprint content in this repo's
# history under a path Blueprint knows nothing about. `scripts/bp_stage.py --list` reads them.
.bp-stage/
